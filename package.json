{
  "name": "sigmawealth-solution-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/sigma-api.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node dist/sigma-api.js",
    "dev": "tsx watch server/sigma-api.ts",
    "build": "esbuild server/sigma-api.ts --platform=node --format=esm --packages=external --bundle --outfile=dist/sigma-api.js",
    "postinstall": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/test-bachs.ts tests/security.unit.test.ts tests/hardening.unit.test.ts",
    "test:bachs": "node --import tsx --test tests/test-bachs.ts",
    "test:live-bachs": "node --import tsx scripts/test-live-bachs.ts",
    "check:bachs": "node --import tsx scripts/check-bachs.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "reconcile:bachs": "node scripts/reconcile-bachs.mjs",
    "test:load": "npm run build && node scripts/test-local-load.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.18.4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
